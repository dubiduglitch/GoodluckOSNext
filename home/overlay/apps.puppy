[ARCHIVE]
NAME=Nintendo Entertainment System
DESCRIPTION=Nintendo NES / Famicom
ENTRY_DIRECTORIES=/media/external/NES;/media/external/Famicom;/home/player/roms/nes;/home/player/roms/famicom
ENTRY_EXTENSIONS=nes;fds;unf;unif;zip;7z
ENTRY_ICONS_DIRECTORIES=/media/external/NES/icons;/media/external/Famicom/icons;/home/player/roms/nes/icons;/home/player/roms/famicom/icons
ART_DIRECTORIES=/media/external/NES/icons;/media/external/Famicom/icons;/home/player/roms/nes/icons;/home/player/roms/famicom/icons
DEFAULT_ICON=/home/player/icons/nintendo_nes.png
COMMAND=retroarch -L /home/player/cores/fceumm_libretro.so %s

