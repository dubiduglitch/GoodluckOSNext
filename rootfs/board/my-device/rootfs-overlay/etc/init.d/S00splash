#!/bin/sh
# Draw the boot splash (start.png) as early as possible, before the slower
# services, and hide the VT cursor so no blinking caret shows through it.
case "$1" in
    stop|restart) exit 0 ;;
esac

SPLASH=/home/player/.local/share/goodluckos/splash-boot.png

if [ -c /dev/tty1 ]; then
    printf '\033[2J\033[H\033[?25l' >/dev/tty1 2>/dev/null
fi

if [ -f "$SPLASH" ] && command -v fbv >/dev/null 2>&1; then
    fbv -u -c -f "$SPLASH" </dev/null >/dev/null 2>&1
fi

exit 0
